@model Blog.Models.Iletisim


    <script type="text/javascript" src="~/Content/Content/Script/js/plugins/bootstrap/bootstrap-file-input.js"></script>
    <script type="text/javascript" src="~/Content/Content/Script/js/plugins/bootstrap/bootstrap-select.js"></script>
    <script type="text/javascript" src="~/Content/Content/Script/js/plugins/tagsinput/jquery.tagsinput.min.js"></script>
    <script type="text/javascript" src="~/Content/Content/Script/js/plugins/summernote/summernote.js"></script>

    <div class="container">
        <div class="box text-center">
            <br>
            <h2>İletişim Bilgilerimiz</h2>
        </div><!-- /.box -->
    </div><!-- /.container -->


    <section class="contact_us">
        <div class="container">
            <div class="row">
                <div class="col-md-8 col-sm-12 col-xs-12">
                    <div class="sec-title">
                        <h2>Bize Yazın</h2>
                    </div>
                    <div class="default-form-area">
                        @using (Html.BeginForm("MesajEkle", "Iletisim", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
            <div class="row clearfix">
                <div class="col-md-6 col-sm-6 col-xs-12">

                    <div class="form-group">
                        <input type="text" name="Isim" class="form-control" value="" placeholder="İsminiz *" required="" aria-required="true">
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <input type="email" name="EMail" class="form-control required email" value="" placeholder="Mail Adresiniz *" required="" aria-required="true">
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <input type="text" name="Telefon" class="form-control" value="" placeholder="Telefon">
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <input type="text" name="Konu" class="form-control" value="" placeholder="Konu">
                    </div>
                </div>
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <textarea name="Icerik" class="form-control textarea required" placeholder="Mesajınız" aria-required="true"></textarea>
                    </div>
                </div>
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <input id="form_botcheck" name="form_botcheck" class="form-control" type="hidden" value="">
                        <button class="btn btn-danger" type="submit" data-loading-text="Please wait...">Gönder</button>
                    </div>
                </div>

            </div>}
                    </div>
                </div>

                <div class="col-md-4 col-sm-8 col-xs-12">
                    <div class="sec-title">
                        <h2>Adreslerimiz</h2>
                    </div>
                    <br>
                    <div class="default-cinfo">

                        <div class="acc-content collapsed">
                            <ul class="contact-infos">
                                @foreach (var item in Model.Genel_Ayarlar)
                                {
                    <li>
                        <div class="icon_box">
                            <i class="fa fa-map-marker"></i>
                        </div><!-- /.icon-box -->
                        <div class="text-box">
                            <p><b>Adres:</b> <br> @item.Adres</p>
                        </div><!-- /.text-box -->
                    </li>
                                    <li>
                                        <div class="icon_box">
                                            <i class="fa fa-phone"></i>
                                        </div><!-- /.icon-box -->
                                        <div class="text-box">
                                            <p><b>Telefon:</b> <br> @item.Tel</p>
                                        </div><!-- /.text-box -->
                                    </li>
                                                    <li>
                                                        <div class="icon_box">
                                                            <i class="fa fa-envelope"></i>
                                                        </div><!-- /.icon-box -->
                                                        <div class="text-box">
                                                            <p><b>Mail:</b> <br> @item.EMail</p>
                                                        </div>
                                                    </li>}


                            </ul>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="map-section">
        <div class="map-outer">
            <iframe src="https://www.google.com/maps/d/u/0/embed?mid=1xFQIhPo7qlJrMeNkGi4zGfE1jbf8DtYZ" width="100%" height="450" frameborder="0" style="border:0" allowfullscreen></iframe>
        </div>
        <br>
    </div>
