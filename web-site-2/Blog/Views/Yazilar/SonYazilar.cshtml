@{
    Layout = null;
}
@model IEnumerable<Blog.Models.Yazilar>
    <!--Son Yazilar Listesi Listesi -->


@if (Model != null) {
@foreach (var item in Model.Take(3))
{
    <div class="post mt-3">
        <a class="yaziBaslik" href="/Yazilar/YazilarDetay/@item.Id"><h5 class="display-5">@item.Baslik</h5></a>
        <p>
            <span class="badge bg-primary text-white">@item.Kategori.KategoriAdi</span>
            <span class="badge bg-danger text-white">@item.EklemeTarihi.ToString("dd MMMM yyyy")</span>
        </p>
        <p>
            @item.KisaMetin
        </p>
        <a class="yaziBaslik text-white" href="/Yazilar/YazilarDetay/@item.Id">
            <div class="btn btn-success devami">Devamı</div>
        </a>
        <hr>
    </div>
}
}


