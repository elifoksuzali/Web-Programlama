@{
    ViewBag.Title = "SayfaDetay";
    var birustsayfaBaslik = ViewBag.UstSayfa;
    var sayfaBaslik = ViewBag.Sayfa;
    var icerik = ViewBag.Icerik;
}


<div class="space_10"> </div>
<div class="col-md-1">   </div>
<div class="col-md-11">
    <ul class="breadcrumb pull-left">
        <li class="home breadcrumb-item"><i class="fa fa-home"></i> <a href="/Anasayfa/Anasayfa">Anasayfa</a></li>
        <li class="breadcrumb-item">
            <a href="#">
                @if (birustsayfaBaslik != null)
                {@birustsayfaBaslik}
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="#">
                @if (sayfaBaslik != null)
                {@sayfaBaslik}
            </a>
        </li>
    </ul>
</div>


<div id="blog_post" class="page">
    <div class="container">
        <div class="row">
            <div class="posts col-md-12">
                <h1 class="block_title">
                    @if (sayfaBaslik != null)
                    {@sayfaBaslik}
                else { }
                </h1>
                <div class="post">

                    <div class="details">

                        <div class="summary">
                            @*<iframe width="660" height="315" src="" frameborder="0" allowfullscreen></iframe>*@
                            <img style="width: 100%;vertical-align: middle;border-style: none;max-width: 100%;" src="@if (icerik != null)
                        {
                            @icerik.KucukResimYolu
                        }" />
                        </div>
                        <p></p><p>
                            @if (icerik != null)
                            {
                                @Html.Raw(icerik.IcerikAciklama)
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



