@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<Blog.Models.Yazilar>
<!-- RENDER -->
<div class="page-content-wrap">
    <div class="row">
        <div class="col-md-12">
            <!-- START DATATABLE EXPORT -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">İçerik Listesi / <a style="color:red;" href="/Admin/YaziYonetimi/YaziListele">Yeni İçerik Ekle</a></h3>
                    <ul class="panel-controls">
                        <li><a href="#" class="panel-collapse"><span class="fa fa-angle-down"></span></a></li>
                        <li><a href="#" class="panel-refresh"><span class="fa fa-refresh"></span></a></li>
                        <li><a href="#" class="panel-remove"><span class="fa fa-times"></span></a></li>
                    </ul>
                </div>
                <div class="panel-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Başlık</th>
                                <th>İçerik</th>
                                <th>Kategori Adı</th>
                                <th>Ekleyen</th>
                                <th>Ekleme Tarihi</th>
                                <th>Dil</th>
                                <th>Resim</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                @if (item.Kategori != null)
                                {
                                    <td>@item.Id</td>
                                    <td>@item.Baslik</td>
                                    <td>@item.Icerik</td>
                                    <td>@item.Kategori.KategoriAdi</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                <td>Emre</td>
                                <td>@item.EklemeTarihi</td>
                                <td>@item.Language</td>
                                <td><img src="@item.KucukResimYolu" width="80px" height="50px" /></td>
                                <td>
                                    @Html.ActionLink("Düzenle", "YaziGetir", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })

                                    @Html.ActionLink("Sil", "YaziSil", new { id = item.Id }, new { @class = "btn btn-info btn-sm", onclick = "return confirm('Gerçekten Silmek istiyor musunuz?')" })
                                </td>
                            </tr>

                            }



                        </tbody>
                    </table>
                </div>
            </div>


        </div>
    </div>
</div>
<!-- RENDER -->
