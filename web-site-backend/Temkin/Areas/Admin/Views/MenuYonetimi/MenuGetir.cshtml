@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model Temkin.Models.UstMenu

<script type="text/javascript" src="~/Content/Content/Script/js/plugins/bootstrap/bootstrap-file-input.js"></script>
<script type="text/javascript" src="~/Content/Content/Script/js/plugins/bootstrap/bootstrap-select.js"></script>
<script type="text/javascript" src="~/Content/Content/Script/js/plugins/tagsinput/jquery.tagsinput.min.js"></script>
<script type="text/javascript" src="~/Content/Content/Script/js/plugins/summernote/summernote.js"></script>


<!-- RENDER -->
<div class="page-content-wrap">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("MenuDuzenle", "MenuYonetimi", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="form-horizontal">

                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3 class="panel-title"><strong>Menu</strong> Düzenle / <a style="color:red;" href="/Admin/MenuYonetimi/MenuListele">Geri</a></h3>
                            <ul class="panel-controls">
                                <li><a href="#" class="panel-remove"><span class="fa fa-times"></span></a></li>
                            </ul>
                        </div>

                        <div class="panel-body">
                            @Html.HiddenFor(Model => Model.Id);

                        </div>

                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Kategori Adı</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="KategoriAdi" value="@Model.Adi">
                                <span class="help-block"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Açıklama</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="Aciklama" value="@Model.Link">
                           
                                <span class="help-block"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Açıklama</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="Aciklama" value="@Model.Sira">
                              
                                <span class="help-block"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Açıklama</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="Aciklama" value="@Model.AktifMi">
                              
                                <span class="help-block"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Açıklama</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="Aciklama" value="@Model.Language">
                                <span class="help-block"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-12 control-label">Açıklama</label>
                            <div class="col-md-6 col-md-2">
                                <input type="text" class="form-control" name="Aciklama" value="@Model.YeniSayfadaAc">
                           
                                <span class="help-block"></span>
                            </div>
                        </div>



                    </div>
                        <div class="panel-footer">
                            <button class="btn btn-default">Temizle</button>
                            <button class="btn btn-primary pull-right">Kaydet</button>
                        </div>
                    </div>
               

            }

        </div>
    </div>
</div>
<!-- RENDER -->