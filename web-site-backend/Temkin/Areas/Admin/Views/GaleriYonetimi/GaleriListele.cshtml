@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<Temkin.Models.Galeriler>
<!-- RENDER -->
<div class="page-content-wrap">
    <div class="row">
        <div class="col-md-12">
            <!-- START DATATABLE EXPORT -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><strong>Galeri</strong> Listesi / <a style="color:red;" href="/Admin/GaleriYonetimi/GaleriEkle">Yeni Galeri Ekle</a></h3>
                    <ul class="panel-controls">
                        <li><a href="#" class="panel-collapse"><span class="fa fa-angle-down"></span></a></li>
                        <li><a href="#" class="panel-refresh"><span class="fa fa-refresh"></span></a></li>
                        <li><a href="#" class="panel-remove"><span class="fa fa-times"></span></a></li>
                    </ul>
                </div>
                <div class="panel-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Galeri Adı</th>
                                <th>Ekleyen</th>
                                <th>Ekleme Tarihi</th>
                                <th>Resim</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                @if (item.GaleriAdi != null)
                                {
                                    <td>@item.GaleriAdi</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                <td>@item.EkleyenKisiID</td>
                                <td>@item.EklemeTarihi</td>
                                <td><img src="@item.GaleriResimYolu" width="80px" height="50px" /></td>
                                <td></td>


                                <td>
                                    @Html.ActionLink("Düzenle", "GaleriGetir", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })

                                    @Html.ActionLink("Sil", "ResimSil", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })
                                </td>
                            </tr>

                            }



                        </tbody>
                    </table>
                </div>
            </div>


        </div>
    </div>
</div>
<!-- RENDER -->
